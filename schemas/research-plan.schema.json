{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchPlan",
  "type": "object",
  "required": ["title", "decisionInformed", "studies"],
  "properties": {
    "title": { "type": "string" },
    "decisionInformed": { "type": "string" },
    "audienceResolutionRef": { "type": ["string", "null"] },
    "studies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "method", "researchQuestions"],
        "properties": {
          "name": { "type": "string" },
          "method": { "type": "string" },
          "researchQuestions": { "type": "array", "items": { "type": "string" } },
          "participants": { "type": "string" },
          "timeline": { "type": "string" },
          "sourceRefs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "outOfScope": { "type": "array", "items": { "type": "string" } }
  }
}
